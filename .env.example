# GEMINI_API_KEY: Clave para servicios auxiliares
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL canónica del sitio (para SEO, sitemap y OpenGraph)
APP_URL="https://vortex-arte-geometria.com"

# VITE_WHATSAPP_NUMBER: Número de WhatsApp con código de país para consultas y compras directas
# Ejemplo para España: "34600112233" (sin símbolos +, espacios ni guiones)
VITE_WHATSAPP_NUMBER="34600000000"

# VITE_INSTAGRAM_URL: Enlace al perfil de Instagram de la artista
VITE_INSTAGRAM_URL="https://instagram.com/[COMPLETAR_USUARIO]"

# RESEND_API_KEY: Para envío transaccional de correos desde /api/contacto (opcional para Vercel)
RESEND_API_KEY="re_123456789"

# CONTACT_RECEIVER_EMAIL: Dirección donde la artista recibe las consultas de la web
CONTACT_RECEIVER_EMAIL="contacto@tu-dominio.com"
